# ai-rm site settings. Copy to deploy/clusters/<name>/cluster.local.env (untracked) and fill in.
# Never commit real addresses or credentials.

# llm-d entry point (Gateway / InferencePool service)
LLMD_GATEWAY_URL=http://<gateway-host>:<port>
LLMD_NAMESPACE=llm-d

# Cluster nodes by role (k8s node names are fine; addresses only here)
NODE_CONTROL_PLANE_IP=<node-ip>
NODE_RNGD_IP=<node-ip>
NODE_ATOM_IP=<node-ip>
NODE_GPU_IP=<node-ip>

# Monitoring
PROMETHEUS_URL=http://<prometheus-host>:9090
GRAFANA_URL=http://<grafana-host>:3000

# Credentials: point to files outside the repo, never inline secrets
KUBECONFIG=<path-to-kubeconfig>
HF_TOKEN_FILE=<path-to-file-with-hf-token>
