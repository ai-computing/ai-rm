# Engine consolidation plan: config/engine-integration.yaml
# Keep existing submodules as migration sources until Optimus Prime is validated.
# The planned aicomp/optimus-prime branch is not created or activated here.
[submodule "rm-accel"]
	path = components/l1-accel/rm-accel
	url = https://github.com/ai-computing/rm-accel.git
	branch = master
[submodule "hetero-npu-p2p"]
	path = components/l2-memory/hetero-npu-p2p
	url = https://github.com/ai-computing/hetero-npu-p2p.git
	branch = main
[submodule "npu-offload"]
	path = components/l2-memory/npu-offload
	url = https://github.com/ai-computing/npu-offload.git
	branch = main
[submodule "rngd-pd"]
	path = components/l3-serving/rngd-pd
	url = https://github.com/ai-computing/rngd-pd.git
	branch = main
[submodule "npu-lora"]
	path = components/l3-serving/npu-train
	url = https://github.com/ai-computing/npu-train.git
	branch = main
[submodule "hetero-llm-d"]
	path = components/l4-cluster/hetero-llm-d
	url = https://github.com/ai-computing/hetero-llm-d.git
	branch = main
[submodule "lmd-top"]
	path = components/l5-ops/lmd-top
	url = https://github.com/ai-computing/lmd-top.git
	branch = main
[submodule "duet"]
	path = components/l2-memory/duet
	url = https://github.com/ai-computing/duet.git
	branch = v2
[submodule "onggi"]
	path = components/l2-memory/onggi
	url = https://github.com/ai-computing/onggi.git
	branch = main
